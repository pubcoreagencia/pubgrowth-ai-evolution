# =============================================================================
# PUB GROWTH AI — Environment Variables
# =============================================================================
#
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env — todos os valores abaixo são sensíveis.
#
# Classificação:
#   PUBLIC   — pode aparecer no cliente (prefixo VITE_ no Vite)
#   SERVER   — apenas no servidor (backend, build)
#   SECRET   — credencial, nunca chegar ao cliente
# =============================================================================

# Supabase project: rjhnfztjikifymxupagb

# --- SERVER ---
# Supabase project URL (servidor — usado pelo servidor para API calls)
# On Cloudflare Workers, these are set as secrets and environment variables.
SUPABASE_URL=https://rjhnfztjikifymxupagb.supabase.co

# --- SECRET — Service role key for server-side Supabase admin operations ---
# CRITICAL: This key grants full admin access. Never expose to the browser.
# The codebase uses lazy imports to prevent bundling into client.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# --- PUBLIC — Can safely appear in the client (publishable/anon key by design) ---
SUPABASE_PROJECT_ID=rjhnfztjikifymxupagb
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key

# Optional Vite aliases for local/browser-only tooling.
# The app also injects runtime Supabase config from server env.
VITE_SUPABASE_URL=https://rjhnfztjikifymxupagb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key

# --- SECRET — Banco Inter PIX (never expose to client) ---
INTER_ENV=sandbox
INTER_CLIENT_ID=replace_with_inter_client_id
INTER_CLIENT_SECRET=replace_with_inter_client_secret
INTER_PIX_KEY=replace_with_inter_pix_key
INTER_ACCOUNT_NUMBER=optional_inter_checking_account_number_without_leading_zeroes

# --- SECRET — Webhook authentication (mandatory, fail-closed if absent) ---
# Generate with: openssl rand -hex 32
INTER_WEBHOOK_SECRET=replace_with_random_webhook_secret

# --- SERVER — Cloudflare Workers bindings ---
# INTER_CERTIFICATE and INTER_PRIVATE_KEY are provided as CF Worker bindings.
# For non-CF local testing they can be set as base64 env vars:
INTER_CERTIFICATE_BASE64=replace_with_base64_client_certificate
INTER_PRIVATE_KEY_BASE64=replace_with_base64_private_key

# --- SECRET — Cloudflare deploy automation (GitHub Actions secrets) ---
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token